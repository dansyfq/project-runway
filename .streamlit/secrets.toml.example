# Copy to .streamlit/secrets.toml (gitignored) or paste into Streamlit Cloud > App settings > Secrets.
# Generate the [auth.users] block with:  python scripts/seed_users.py
ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-haiku-5-5"  # default is claude-opus-5-5; Haiku costs far less per answer
# Lasting storage for admin edits, uploaded Ask documents and answer votes (runway/store.py):
# DATABASE_URL = "postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# R2_ACCOUNT_ID = "..."          # Cloudflare R2 keeps the original uploaded files
# R2_ACCESS_KEY_ID = "..."
# R2_SECRET_ACCESS_KEY = "..."
# R2_BUCKET = "runway-uploads"
# Without DATABASE_URL, a GitHub token keeps edits instead:
# GITHUB_TOKEN = "github_pat_..."  # keeps admin uploads and page edits: fine-grained, this repo only, Contents read/write
# Built-in accounts (runway/auth.py) that can log in; default "admin,user". "user" turns the built-in admin off:
# BUILTIN_ACCOUNTS = "admin,user"

# Extra accounts, or a new password for a built-in one (same name: this entry wins). Never put plain passwords here.
[auth.users]
# username = "pbkdf2_sha256$600000$<salt>$<hash>"   (written by the seed script) an admin, or for admin/user that account's own role
# username = { hash = "pbkdf2_sha256$600000$<salt>$<hash>", role = "user" }   role "admin" or "user"
